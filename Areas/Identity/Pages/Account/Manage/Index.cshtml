@page
@using PGDCP.Areas.Identity.Pages.Account.Manage
@model IndexModel
@{
    ViewData["Title"] = "Perfil de Usuario";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-9">
        @* Usamos el ID del formulario para que coincida con el code-behind *@
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="card p-4 shadow-sm">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Nombre" class="form-label">Nombre</label>
                        <input asp-for="Input.Nombre" class="form-control" />
                        <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Apellido" class="form-label">Apellido</label>
                        <input asp-for="Input.Apellido" class="form-control" />
                        <span asp-validation-for="Input.Apellido" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.FechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                        <input asp-for="Input.FechaNacimiento" class="form-control" type="date" />
                        <span asp-validation-for="Input.FechaNacimiento" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Sexo" class="form-label">Sexo</label>
                        <select asp-for="Input.Sexo" class="form-select">
                            <option value="">— Seleccione —</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                        </select>
                        <span asp-validation-for="Input.Sexo" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.PhoneNumber" class="form-label">Teléfono</label>
                    <input asp-for="Input.PhoneNumber" class="form-control" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mt-3">
                    <button id="update-profile-button" type="submit" class="btn btn-lg w-100"
                            style="background-color:#8B7344; color:white; font-weight:bold;">
                        GUARDAR CAMBIOS EN PERFIL
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}