@{
    ViewData["Title"] = "Panel de Control Administrativo";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark" style="font-family: 'Playfair Display', serif;">Panel de Administración</h2>
            <p class="text-muted">Estado global del sistema y configuración de seguridad.</p>
        </div>
        <span class="badge bg-dark p-2">v1.0.4 - 2026</span>
    </div>

    @* Mensajes de éxito o error del mantenimiento *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 15px;">
                <h5 class="fw-bold mb-4"><i class="bi bi-graph-up-arrow me-2"></i>Resumen de Actividad</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 border rounded text-center">
                            <div class="text-muted small">Obras Totales</div>
                            <div class="h3 fw-bold">@ViewBag.TotalObras</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded text-center">
                            <div class="text-muted small">Usuarios Activos</div>
                            <div class="h3 fw-bold">@ViewBag.TotalUsuarios</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded text-center">
                            <div class="text-muted small">Servicios Realizados</div>
                            <div class="h4 fw-bold text-success">@((int)ViewBag.TotalConservaciones + (int)ViewBag.TotalValoraciones)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4" style="border-radius: 15px;">
                <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>Estado del Servidor</h5>
                <p class="small text-muted">Sincronización con base de datos: <span class="text-success">Activa</span></p>
                <p class="small text-muted">Última migración detectada: <span class="fw-bold">SyncFinalPerfilUsuario</span></p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 15px; background-color: #fdfcf9; border: 1px solid #e2d9c5 !important;">
                <h5 class="fw-bold mb-4"><i class="bi bi-gear-fill me-2"></i>Configuración</h5>
                
                <div class="list-group list-group-flush">
                    <a asp-action="Usuarios" class="list-group-item list-group-item-action border-0 py-3 bg-transparent">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold"><i class="bi bi-people me-2"></i>Usuarios</h6>
                                <small class="text-muted">Cuentas, perfiles y accesos.</small>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </div>
                    </a>

                    <a asp-action="Roles" class="list-group-item list-group-item-action border-0 py-3 bg-transparent">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold"><i class="bi bi-shield-check me-2"></i>Roles y Permisos</h6>
                                <small class="text-muted">Definir qué puede hacer cada uno.</small>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </div>
                    </a>

                    @* Corregido para evitar 404 enviando a Categorias directamente *@
                    <a asp-controller="Catalogos" asp-action="Categorias" class="list-group-item list-group-item-action border-0 py-3 bg-transparent">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold"><i class="bi bi-tags me-2"></i>Diccionarios Técnicos</h6>
                                <small class="text-muted">Materiales, épocas y categorías.</small>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </div>
                    </a>
                    
                    @* ZONA CRÍTICA INTEGRADA *@
                    <div class="mt-4 p-3 bg-white rounded border border-warning shadow-sm">
                        <h6 class="fw-bold text-warning-emphasis small text-uppercase">
                            <i class="bi bi-exclamation-triangle me-2"></i>Zona Crítica
                        </h6>
                        <p class="text-muted" style="font-size: 0.75rem;">Usa esto si has realizado cambios manuales en la base de datos o migraciones pendientes.</p>
                        <form asp-action="EjecutarMantenimiento" method="post">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 mt-2">
                                <i class="bi bi-arrow-repeat me-1"></i> Sincronizar Base de Datos
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>