@model IEnumerable<PGDCP.Models.Obra>
@{
    ViewData["Title"] = "Catálogo de Obras";
}

<div class="page-header">
    <h1>Catálogo de Obras</h1>
    @if (User.IsInRole("Administrador") || User.IsInRole("Coleccionista"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Nueva obra</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">✓ @TempData["Success"]</div>
}

<form method="get" class="mb-3">
    <div class="d-flex gap-2" style="max-width:420px;">
        <input type="text" name="buscar" value="@ViewBag.Buscar"
               class="form-control" placeholder="Buscar por título, autor, época..." />
        <button type="submit" class="btn btn-outline-light">Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
        {
            <a asp-action="Index" class="btn btn-outline-light">✕</a>
        }
    </div>
</form>

<div class="card fade-in">
    <div class="table-wrapper" style="border:none;border-radius:0;">
        <table class="table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Categoría</th>
                    <th>Época</th>
                    <th>Estilo</th>
                    <th>Valor estimado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;color:var(--text-muted);padding:2rem;">
                            No hay obras registradas.
                        </td>
                    </tr>
                }
                @foreach (var obra in Model)
                {
                    <tr>
                        <td>
                            <span style="font-family:var(--fd);color:var(--ivory);">@obra.Titulo</span>
                        </td>
                        <td style="color:var(--text-muted);">@obra.Autor</td>
                        <td>
                            @if (obra.Categoria != null)
                            {
                                <span class="badge badge-rose">@obra.Categoria.Nombre</span>
                            }
                        </td>
                        <td>
                            @if (obra.Epoca != null)
                            {
                                <span class="badge badge-teal">@obra.Epoca.Nombre</span>
                            }
                        </td>
                        <td style="color:var(--text-muted);font-size:.85rem;">
                            @obra.Estilo?.Nombre
                        </td>
                        <td>
                            <span style="color:var(--gold-light);font-family:var(--fd);">
                                $@obra.ValorEstimado.ToString("N0")
                            </span>
                        </td>
                        <td>
                            <div class="action-links">
                                <a class="action-link" asp-action="Details" asp-route-id="@obra.Id">Ver</a>
                                @if (User.IsInRole("Administrador") ||
                                                                     (User.IsInRole("Coleccionista") && obra.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                                {
                                    <span class="action-sep">·</span>
                                    <a class="action-link" asp-action="Edit" asp-route-id="@obra.Id">Editar</a>
                                }
                                @if (User.IsInRole("Administrador"))
                                {
                                    <span class="action-sep">·</span>
                                    <a class="action-link" asp-action="Delete" asp-route-id="@obra.Id"
                                       style="color:var(--rose);">Eliminar</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>