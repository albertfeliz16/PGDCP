@model PGDCP.Models.Obra
@{
    ViewData["Title"] = Model.Titulo;
    var imagenPrincipal = Model.Imagenes?.FirstOrDefault(i => i.EsPrincipal)
                          ?? Model.Imagenes?.FirstOrDefault();
}

<div class="page-header">
    <h1>@Model.Titulo</h1>
    <a asp-action="Index" class="btn btn-sm" style="color:var(--text-muted);">← Volver</a>
</div>

<div class="row g-4 fade-in">

    @* Imagen *@
    <div class="col-md-4">
        <div class="card" style="padding:0;overflow:hidden;">
            @if (imagenPrincipal != null)
            {
                <img src="@imagenPrincipal.Url" alt="@Model.Titulo"
                     style="width:100%;height:280px;object-fit:cover;" />
            }
            else
            {
                <div style="width:100%;height:280px;background:var(--surface-2);
                    display:flex;align-items:center;justify-content:center;
                    color:var(--text-muted);font-size:3rem;">
                    🖼
                </div>
            }
        </div>
        @if (Model.Imagenes != null && Model.Imagenes.Count > 1)
        {
            <div class="d-flex gap-2 flex-wrap mt-2">
                @foreach (var img in Model.Imagenes)
                {
                    <img src="@img.Url" style="width:60px;height:60px;object-fit:cover;border-radius:4px;" />
                }
            </div>
        }
    </div>

    @* Datos *@
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Información de la obra</div>
            <div class="card-body">
                <dl class="row" style="margin:0;">
                    <dt class="col-sm-4" style="color:var(--text-muted);">Autor</dt>
                    <dd class="col-sm-8">@(Model.Autor ?? "—")</dd>

                    <dt class="col-sm-4" style="color:var(--text-muted);">Categoría</dt>
                    <dd class="col-sm-8">
                        @if (Model.Categoria != null)
                        {
                            <span class="badge badge-rose">@Model.Categoria.Nombre</span>
                        }
                        else
                        {

                            <span>—</span>
                        }
                    </dd>

                    <dt class="col-sm-4" style="color:var(--text-muted);">Época</dt>
                    <dd class="col-sm-8">
                        @if (Model.Epoca != null)
                        {
                            <span class="badge badge-teal">@Model.Epoca.Nombre</span>
                        }
                        else
                        {

                            <span>—</span>
                        }
                    </dd>

                    <dt class="col-sm-4" style="color:var(--text-muted);">Estilo</dt>
                    <dd class="col-sm-8">@(Model.Estilo?.Nombre ?? "—")</dd>

                    <dt class="col-sm-4" style="color:var(--text-muted);">Ubicación</dt>
                    <dd class="col-sm-8">@(Model.Ubicacion?.Nombre ?? "—")</dd>

                    <dt class="col-sm-4" style="color:var(--text-muted);">Fecha adquisición</dt>
                    <dd class="col-sm-8">@Model.FechaAdquisicion.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4" style="color:var(--text-muted);">Valor estimado</dt>
                    <dd class="col-sm-8">
                        <span style="color:var(--gold-light);font-family:var(--fd);font-size:1.1rem;">
                            $@Model.ValorEstimado.ToString("N0") USD
                        </span>
                    </dd>

                    @if (!string.IsNullOrEmpty(Model.Descripcion))
                    {
                        <dt class="col-sm-4" style="color:var(--text-muted);">Descripción</dt>
                        <dd class="col-sm-8">@Model.Descripcion</dd>
                    }

                    @if (Model.ObraMateriales != null && Model.ObraMateriales.Any())
                    {
                        <dt class="col-sm-4" style="color:var(--text-muted);">Materiales</dt>
                        <dd class="col-sm-8">
                            @foreach (var om in Model.ObraMateriales)
                            {
                                <span class="badge badge-purple me-1">@om.Material?.Nombre</span>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            @if (User.IsInRole("Administrador") || User.IsInRole("Coleccionista"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">Editar</a>
            }
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">Eliminar</a>
            }
            <a asp-action="Index" class="btn btn-outline-light btn-sm">Volver al catálogo</a>
        </div>
    </div>
</div>