@using PGDCP.Models
@model PGDCP.Models.Obra
@{
    ViewData["Title"] = "Nueva Obra";
}

<div class="page-header">
    <h1>Registrar Nueva Obra</h1>
    <a asp-action="Index" class="btn btn-sm" style="color:var(--text-muted);">← Volver</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card fade-in">
            <div class="card-header">Datos de la obra</div>
            <div class="card-body">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="Titulo" class="form-label">Título *</label>
                                <input asp-for="Titulo" class="form-control" placeholder="Título de la obra" />
                                <span asp-validation-for="Titulo" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Autor" class="form-label">Autor</label>
                                <input asp-for="Autor" class="form-control" placeholder="Nombre del autor" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CategoriaId" class="form-label">Categoría</label>
                                <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                    <option value="">— Seleccione —</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="EpocaId" class="form-label">Época</label>
                                <select asp-for="EpocaId" class="form-select" asp-items="ViewBag.EpocaId">
                                    <option value="">— Seleccione —</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="EstiloId" class="form-label">Estilo</label>
                                <select asp-for="EstiloId" class="form-select" asp-items="ViewBag.EstiloId">
                                    <option value="">— Seleccione —</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="TecnicaId" class="form-label">Técnica</label>
                                <select asp-for="TecnicaId" class="form-select" asp-items="ViewBag.TecnicaId">
                                    <option value="">— Seleccione —</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="UbicacionId" class="form-label">Ubicación</label>
                                <select asp-for="UbicacionId" class="form-select" asp-items="ViewBag.UbicacionId">
                                    <option value="">— Seleccione —</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">Materiales</label>
                                <div class="d-flex flex-wrap gap-2 p-2 border rounded bg-light">
                                    @if (ViewBag.Materiales != null)
                                    {
                                        foreach (var mat in (List<PGDCP.Models.Material>)ViewBag.Materiales)
                                        {
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox" name="materialesSeleccionados" value="@mat.Id" id="mat_@mat.Id">
                                                <label class="form-check-label small" for="mat_@mat.Id">@mat.Nombre</label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No hay materiales definidos</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FechaAdquisicion" class="form-label">Fecha de Adquisición</label>
                                <input asp-for="FechaAdquisicion" class="form-control" type="date" />
                                <span asp-validation-for="FechaAdquisicion" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ValorEstimado" class="form-label">Valor Estimado (USD)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                 
                                    <input asp-for="ValorEstimado" class="form-control" type="number"
                                           step="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="ValorEstimado" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Descripcion" class="form-label">Descripción</label>
                                <textarea asp-for="Descripcion" class="form-control" rows="3"
                                          placeholder="Descripción general de la obra..."></textarea>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-label">Imagen</label>
                                <input type="file" name="imagenArchivo" class="form-control"
                                       accept=".jpg,.jpeg,.png,.gif,.webp" />
                            </div>
                        </div>
                    </div>

                    <hr class="divider">
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Guardar obra</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>