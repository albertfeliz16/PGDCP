@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    var enLoginORegistro = currentPath.Contains("/login") ||
                           currentPath.Contains("/register") ||
                           currentPath.Contains("/account");
}

<ul class="navbar-nav align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        @if (User.IsInRole("Administrador"))
        {
            <li class="nav-item"><span class="role-pill role-admin">Administrador</span></li>
        }
        else if (User.IsInRole("Restaurador"))
        {
            <li class="nav-item"><span class="role-pill role-rest">Restaurador</span></li>
        }
        else if (User.IsInRole("Perito"))
        {
            <li class="nav-item"><span class="role-pill role-perito">Perito</span></li>
        }
        else
        {
            <li class="nav-item"><span class="role-pill role-col">Coleccionista</span></li>
        }

        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-uppercase fw-bold"
                   href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                   style="color:var(--gold)!important; font-size:.78rem; letter-spacing: 0.5px;">
                @User.Identity?.Name
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="background-color: #fdfcf9; border: 1px solid #e2d9c5 !important;">
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Email" style="font-size: 0.8rem;">
                        <i class="bi bi-envelope me-2"></i> Cambiar Correo
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword" style="font-size: 0.8rem;">
                        <i class="bi bi-lock me-2"></i> Cambiar Contraseña
                    </a>
                </li>
            </ul>
        </li>

        <li class="nav-item">
            <form class="m-0" asp-controller="Login" asp-action="Salir" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm"
                        style="border-color:rgba(201,168,76,.28);color:var(--text-muted);font-size:.7rem;">
                    Salir
                </button>
            </form>
        </li>
    }
    else if (!enLoginORegistro)
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Registrarse</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sm btn-gold ms-1" asp-controller="Login" asp-action="Index">
                Iniciar sesión
            </a>
        </li>
    }
</ul>