@model PGDCP.Models.SeguridadViewModel

@{
    ViewData["Title"] = "Seguridad de la Cuenta";
}

@* Contenedor principal con fondo suave *@
<div class="container-fluid py-5" style="background-color: #fcfaf5; min-height: 80vh;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            
            @* Mensaje de éxito/error *@
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-left: 5px solid #8B7344;">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @* Tarjeta principal con estilo elegante *@
            <div class="card shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header bg-white pt-4 border-0 text-center">
                    <h2 style="color: #8B7344; font-family: 'Playfair Display', serif; font-weight: 700;">Seguridad</h2>
                    <p class="text-muted small">Actualiza tus credenciales de acceso al sistema</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Seguridad" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* Sección de Email *@
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label text-uppercase fw-bold small" style="color: #555; letter-spacing: 1px;"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white" style="border-color: #e2d9c5;"><i class="fas fa-envelope" style="color: #8B7344;"></i></span>
                                <input asp-for="Email" class="form-control" style="border-color: #e2d9c5; background-color: #fffdf9;" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" style="border-top: 1px solid #e2d9c5;">

                        <h5 class="mb-3" style="color: #8B7344; font-size: 1rem; font-weight: 600;">CAMBIAR CONTRASEÑA</h5>

                        @* Contraseña Actual *@
                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label small fw-bold" style="color: #555;"></label>
                            <input asp-for="OldPassword" class="form-control" placeholder="Escribe tu clave actual" style="border-color: #e2d9c5;" />
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            @* Nueva Contraseña *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewPassword" class="form-label small fw-bold" style="color: #555;"></label>
                                <input asp-for="NewPassword" class="form-control" style="border-color: #e2d9c5;" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            @* Confirmar *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label small fw-bold" style="color: #555;"></label>
                                <input asp-for="ConfirmPassword" class="form-control" style="border-color: #e2d9c5;" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        @* Botón de Acción *@
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-lg text-white shadow-sm"
                                    style="background-color: #8B7344; border-radius: 8px; font-size: 0.9rem; font-weight: 700; letter-spacing: 1px;">
                                GUARDAR CAMBIOS DE SEGURIDAD
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @* Botón para volver *@
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: #8B7344; font-size: 0.85rem;">
                    <i class="fas fa-arrow-left me-1"></i> Volver al inicio
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}