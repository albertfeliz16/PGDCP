@model PGDCP.Models.SeguridadViewModel
@{
    ViewData["Title"] = "Seguridad";
}

<div class="container py-5">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 500px; border-radius: 15px;">
        <div class="card-body p-4">
            <h3 class="text-center mb-4" style="color: #8B7344;">Seguridad de la Cuenta</h3>
            <form asp-action="Seguridad" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold small">CORREO ELECTRÓNICO</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <hr>
                <div class="mb-3">
                    <label asp-for="OldPassword" class="form-label small">Contraseña Actual</label>
                    <input asp-for="OldPassword" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small">Nueva Contraseña</label>
                    <input asp-for="NewPassword" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label small">Confirmar Nueva Contraseña</label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                </div>
                <button type="submit" class="btn w-100 text-white" style="background-color: #8B7344; font-weight: bold;">ACTUALIZAR DATOS</button>
            </form>
        </div>
    </div>
</div>