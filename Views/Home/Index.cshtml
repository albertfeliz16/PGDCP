@using PGDCP.Models
@{
    ViewData["Title"] = "Inicio";
    var userName = User.Identity?.Name?.Split('@')[0] ?? "";
}

<style>
    :root { --gold: #8B7344; --gold-light: #B59E72; --ivory: #2C2C2C; --teal: #4A707A; }
    .stat-card { background: #fdfcf9; border-radius: 15px; padding: 1.5rem; border: 1px solid #e2d9c5; box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: transform 0.2s; height: 100%; }
    .stat-card:hover { transform: translateY(-3px); }
    .stat-label { font-size: 0.75rem; font-weight: bold; color: #888; text-transform: uppercase; letter-spacing: 1px; }
    .stat-value { font-size: 2rem; font-weight: bold; color: var(--gold); font-family: 'Playfair Display', serif; }
    .badge-gold { background: var(--gold); color: white; padding: 5px 12px; border-radius: 20px; font-size: 0.75rem; }
    .table-wrapper { background: white; border-radius: 12px; overflow: hidden; border: 1px solid #eee; }
    .action-link { color: var(--gold); text-decoration: none; font-weight: 600; }
</style>

@if (User.Identity?.IsAuthenticated == true)
{
    @* --- TODO EL CONTENIDO PARA USUARIOS LOGUEADOS (Dashboard) --- *@
    <div class="container py-4">
        <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
            @if (User.IsInRole("Administrador")) { 
                <h1>Panel <em style="color:var(--gold-light);">Administrador</em></h1> <span class="badge-gold">Control total del sistema</span> 
            } else { 
                <h1>Bienvenido, <em style="color:var(--gold-light);">@userName</em></h1> <span class="badge-gold" style="background:#e83e8c;">Coleccionista</span> 
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Total Obras</div>
                    <div class="stat-value">@ViewBag.TotalObras</div>
                </div>
            </div>
            @if (User.IsInRole("Administrador") || User.IsInRole("Restaurador")) {
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-label">Conservaciones</div>
                        <div class="stat-value">@ViewBag.TotalConservaciones</div>
                    </div>
                </div>
            }
            @if (User.IsInRole("Administrador") || User.IsInRole("Perito")) {
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-label">Valoraciones</div>
                        <div class="stat-value">@ViewBag.TotalValoraciones</div>
                    </div>
                </div>
            }
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Valor Colección</div>
                    <div class="stat-value" style="font-size:1.5rem;">$@String.Format("{0:N0}", ViewBag.ValorTotal)</div>
                </div>
            </div>
        </div>

        <h3 class="h5 fw-bold mb-3">Acceso rápido</h3>
        <div class="row g-3 mb-5">
            <div class="col-md-3">
                <div class="stat-card p-3 border-0 shadow-sm text-center">
                    <div class="stat-label mb-2">Obras</div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Obras" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver Catálogo</a>
                        <a asp-controller="Obras" asp-action="Create" class="btn btn-sm btn-gold" style="background:var(--gold); color:white;">+ Nueva</a>
                    </div>
                </div>
            </div>
            @if (User.IsInRole("Administrador")) {
                <div class="col-md-3">
                    <div class="stat-card p-3 text-center" style="background:#f8f5f0; border: 1px dashed var(--gold);">
                        <div class="stat-label mb-2">Usuarios</div>
                        <div class="d-grid gap-2">
                            <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-sm btn-outline-dark">Gestionar</a>
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-dark">Panel Admin</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h5 fw-bold m-0">Obras recientes</h3>
            <a asp-controller="Obras" asp-action="Index" class="btn btn-sm btn-link action-link">Ver todas</a>
        </div>
        <div class="table-wrapper shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Título</th><th>Autor</th><th>Época</th><th>Valor Estimado</th><th>Acción</th></tr>
                </thead>
                <tbody>
                    @if (ViewBag.ObrasRecientes != null) {
                        @foreach (var obra in (List<Obra>)ViewBag.ObrasRecientes) {
                            <tr>
                                <td class="fw-bold">@obra.Titulo</td>
                                <td>@obra.Autor</td>
                                <td><span class="badge bg-light text-dark border">@obra.Epoca?.Nombre</span></td>
                                <td class="fw-bold" style="color:var(--gold);">$@obra.ValorEstimado.ToString("N0")</td>
                                <td><a asp-controller="Obras" asp-action="Details" asp-route-id="@obra.Id" class="action-link">Ver →</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    @* --- VISTA PÚBLICA (LO QUE SE VE AL INICIO) --- *@
    <div class="container mt-5">
        <div style="background-color: #fdfcf9; background-image: radial-gradient(#e2d9c5 0.5px, transparent 0.5px); background-size: 20px 20px; border: 1px solid #e2d9c5; border-radius: 20px; padding: 80px 20px; text-align: center; margin-bottom: 40px;">
            <span style="color: #8B7344; font-weight: bold; text-transform: uppercase; letter-spacing: 3px; font-size: 14px; margin-bottom: 15px; display: block;">
                Patrimonio Cultural
            </span>
            <h1 style="font-size: 60px; color: #2c2c2c; line-height: 1.1; margin: 0 0 20px 0; font-family: 'Playfair Display', serif;">
                Plataforma de Gestión del<br><span style="color: #8B7344;">Patrimonio Cultural</span>
            </h1>
            <p style="color: #6c757d; max-width: 650px; margin: 0 auto; font-size: 18px; line-height: 1.6;">
                Una solución integral para la documentación, protección y puesta en valor de colecciones privadas con los más altos estándares profesionales.
            </p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4 text-center">
                <div class="p-4 h-100 shadow-sm" style="background: white; border: 1px solid #e2d9c5;">
                    <div style="font-size: 40px; color: #8B7344; margin-bottom: 20px;">📋</div>
                    <h4 style="font-family: 'Playfair Display', serif;">Catalogación</h4>
                    <p class="text-muted small">Registro detallado de piezas con metadatos técnicos, autoría y estados de conservación.</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="p-4 h-100 shadow-sm" style="background: white; border: 1px solid #e2d9c5;">
                    <div style="font-size: 40px; color: #8B7344; margin-bottom: 20px;">🛡️</div>
                    <h4 style="font-family: 'Playfair Display', serif;">Conservación</h4>
                    <p class="text-muted small">Seguimiento de intervenciones técnicas y mantenimiento preventivo.</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="p-4 h-100 shadow-sm" style="background: white; border: 1px solid #e2d9c5;">
                    <div style="font-size: 40px; color: #8B7344; margin-bottom: 20px;">💰</div>
                    <h4 style="font-family: 'Playfair Display', serif;">Valoración</h4>
                    <p class="text-muted small">Control de peritajes y estimaciones de valor de mercado actualizadas.</p>
                </div>
            </div>
        </div>
    </div>
}