@model IEnumerable<PGDCP.Models.Epoca>
@{
    ViewData["Title"] = "Épocas";
}

<div class="page-header">
    <h1>Épocas</h1>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-sm" style="color:var(--text-muted);">← Panel Admin</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">✓ @TempData["Success"]</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card fade-in">
            <div class="card-header">Nueva época</div>
            <div class="card-body">
                <form asp-action="CrearEpoca" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-3">
                        <label class="form-label">Nombre *</label>
                        <input name="nombre" class="form-control" required placeholder="Ej: Barroco, Renacimiento..." />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Siglo desde</label>
                            <input name="sigloDesde" type="number" class="form-control" placeholder="Ej: 15" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Siglo hasta</label>
                            <input name="sigloHasta" type="number" class="form-control" placeholder="Ej: 17" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="descripcion" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Agregar</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card fade-in">
            <div class="card-header">Épocas registradas (@Model.Count())</div>
            <div class="table-wrapper" style="border:none;border-radius:0;">
                <table class="table">
                    <thead><tr><th>Nombre</th><th>Siglos</th><th>Descripción</th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:2rem;">No hay épocas registradas.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-family:var(--fd);color:var(--ivory);">@item.Nombre</td>
                                <td style="color:var(--text-muted);font-size:.85rem;">
                                    @(item.SigloDesde != null ? $"S.{item.SigloDesde}" : "—")
                                    @(item.SigloHasta != null ? $" – S.{item.SigloHasta}" : "")
                                </td>
                                <td style="color:var(--text-muted);font-size:.85rem;">@(item.Descripcion ?? "—")</td>
                                <td>
                                    <form asp-action="EliminarEpoca" method="post" onsubmit="return confirm('¿Eliminar @item.Nombre?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>