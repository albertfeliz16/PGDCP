@model IEnumerable<PGDCP.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="page-header">
    <h1>Categorías</h1>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-sm" style="color:var(--text-muted);">← Panel Admin</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">✓ @TempData["Success"]</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card fade-in">
            <div class="card-header">Nueva categoría</div>
            <div class="card-body">
                <form asp-action="CrearCategoria" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-3">
                        <label class="form-label">Nombre *</label>
                        <input name="nombre" class="form-control" required placeholder="Ej: Pintura, Escultura..." />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="descripcion" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Agregar</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card fade-in">
            <div class="card-header">Categorías registradas (@Model.Count())</div>
            <div class="table-wrapper" style="border:none;border-radius:0;">
                <table class="table">
                    <thead><tr><th>Nombre</th><th>Descripción</th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="3" style="text-align:center;color:var(--text-muted);padding:2rem;">No hay categorías registradas.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-family:var(--fd);color:var(--ivory);">@item.Nombre</td>
                                <td style="color:var(--text-muted);font-size:.85rem;">@(item.Descripcion ?? "—")</td>
                                <td>
                                    <form asp-action="EliminarCategoria" method="post" onsubmit="return confirm('¿Eliminar @item.Nombre?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>